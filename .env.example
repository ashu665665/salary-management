# Copy to .env and adjust. .env is not committed.
#
# There are no secrets here. The database lives inside the application container and listens only
# on localhost, so nothing outside can reach it. Nothing in this repository holds a credential that
# protects anything.

# Port the application is published on locally.
APP_PORT=8080

# Demo data. Seeding only ever fills an empty database.
SEED_ENABLED=true
SEED_EMPLOYEE_COUNT=25
SEED_RESET=false

# Local database password. Applied when the volume is first created; changing it afterwards needs
# `docker compose down -v` (which deletes the demo data, and it re-seeds on the next start).
POSTGRES_PASSWORD=salary
